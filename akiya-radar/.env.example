# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=akiya_radar
POSTGRES_USER=akiya
POSTGRES_PASSWORD=akiya_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://akiya:akiya_dev_password@postgres:5432/akiya_radar

# ─── Services ───────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Seed 10 mock listings on first backend start (idempotent).
SEED_ON_START=true

# ─── Auth (single-user MVP) ─────────────────────────────────────────────────
# Protection is opt-in: set AUTH_ENABLED=true to require a JWT on the API.
AUTH_ENABLED=false
ADMIN_PASSWORD=akiya_admin_dev
JWT_SECRET=change-me-in-production

# ─── Pluggable providers (keep "mock" for a no-cost MVP) ─────────────────────
# Real providers (DeepL, Claude, OpenAI, live FX) can be wired later.
EXCHANGE_RATE_PROVIDER=mock
TRANSLATION_PROVIDER=mock
LLM_PROVIDER=mock
JPY_TO_EUR_RATE=0.0060
