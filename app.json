{
  "expo": {
    "name": "MangaTrack",
    "slug": "manga-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manga-track",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mangatrack.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID est utilisé pour déverrouiller votre bibliothèque de lecture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16130E"
      },
      "package": "com.mangatrack.app",
      "permissions": [
        "INTERNET"
      ],
      "usesCleartextTraffic": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID est utilisé pour déverrouiller votre bibliothèque de lecture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "backgroundColor": "#F4EFE3",
      "resizeMode": "contain"
    },
    "updates": {
      "url": "https://u.expo.dev/492585a2-922b-49f1-b58e-8b06a3644f31"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "492585a2-922b-49f1-b58e-8b06a3644f31"
      }
    }
  }
}
